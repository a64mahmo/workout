{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workout Tracker on Cloudflare: one Worker serves the static Next.js export
  // and the /api/* backend. Data lives in SQLite-backed Durable Objects, which
  // the Workers Free plan supports:
  //   - Directory: a single instance that maps email -> user id and password hash
  //   - UserStore: one instance per user, holding all of that user's training data
  //
  // Top level = local dev (`wrangler dev`). `--env staging` / `--env production`
  // for deploys. Bindings and vars do not inherit, so each env repeats them.
  "name": "workout-tracker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only these paths hit the Worker. Everything else is served straight from
    // the asset store and doesn't count against Worker requests.
    "run_worker_first": [
      "/api/*",
      "/sessions/*",
      "/plans/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DIRECTORY",
        "class_name": "Directory"
      },
      {
        "name": "USER_STORE",
        "class_name": "UserStore"
      }
    ]
  },
  // Migrations are shared by all envs. Never edit an applied tag; add a new one.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Directory",
        "UserStore"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  // Workers AI (weight predictions) is bound only in staging/production: the
  // binding always calls the real service, so local `wrangler dev` would need a
  // Cloudflare login. Local dev uses the rules engine. To try AI locally:
  //   npx wrangler login && npx wrangler dev --env staging
  // Free plan: 10,000 neurons/day; predictions are cached per new workout.
  "vars": {
    "ENVIRONMENT": "development",
    // "on" = AI predictions with rules fallback, "off" = rules engine only
    "AI_PREDICTIONS": "off",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:8787",
    "FITBIT_REDIRECT_URI": "http://localhost:8787/settings/fitbit/callback"
  },
  // Secrets: JWT_SECRET_KEY, ADMIN_TOKEN, FITBIT_CLIENT_ID, FITBIT_CLIENT_SECRET
  // local -> .dev.vars ; deployed -> `wrangler secret put <NAME> --env <env>`
  "env": {
    "staging": {
      "name": "workout-tracker-staging",
      "routes": [
        {
          "pattern": "staging.workout.the-desk.ca",
          "custom_domain": true
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "DIRECTORY",
            "class_name": "Directory"
          },
          {
            "name": "USER_STORE",
            "class_name": "UserStore"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "AI_PREDICTIONS": "on",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "ALLOWED_ORIGINS": "https://staging.workout.the-desk.ca",
        "FITBIT_REDIRECT_URI": "https://staging.workout.the-desk.ca/settings/fitbit/callback"
      }
    },
    "production": {
      "name": "workout",
      "ai": {
        "binding": "AI"
      },
      // Custom domain: the-desk.ca must be a zone in this Cloudflare account.
      // Deploy creates the DNS record and certificate automatically.
      "routes": [
        {
          "pattern": "workout.the-desk.ca",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DIRECTORY",
            "class_name": "Directory"
          },
          {
            "name": "USER_STORE",
            "class_name": "UserStore"
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "AI_PREDICTIONS": "on",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "ALLOWED_ORIGINS": "https://workout.the-desk.ca",
        "FITBIT_REDIRECT_URI": "https://workout.the-desk.ca/settings/fitbit/callback"
      }
    }
  }
}